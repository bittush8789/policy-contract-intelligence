# ==============================================================================
# Enterprise RAG Assistant - Configuration Template
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# Pinecone Vector Database
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=enterprise-rag
PINECONE_NAMESPACE=policies-contracts

# Groq LLM API
# Obtain your key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Models
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Ingestion Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval Parameters
VECTOR_TOP_K=20
BM25_TOP_K=20
HYBRID_TOP_K=20
RERANK_TOP_K=5

# Server Configuration
HOST=0.0.0.0
PORT=8000

# AI Guardrails
ENABLE_GUARDRAILS=true
ENABLE_INPUT_GUARDRAILS=true
ENABLE_OUTPUT_GUARDRAILS=true
ENABLE_PII_REDACTION=true
BLOCK_PROMPT_INJECTION=true

# LangSmith Observability
# Get your API key from: https://smith.langchain.com → Settings → API Keys
# Set LANGCHAIN_TRACING_V2=true to activate — leave false to disable
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=enterprise-rag-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
